<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:padding="12dp"
    android:elevation="4dp"
    android:radius="8dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start">

        <TextView android:id="@+id/tvIdCurso" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="none"/>
        <TextView android:id="@+id/tvCodigoCurso" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="none"/>
        <TextView android:id="@+id/tvNombreCurso" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="none"/>
        <TextView android:id="@+id/tvCreditosCurso" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="none"/>
        <TextView android:id="@+id/tvHorasSemanales" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="none"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
