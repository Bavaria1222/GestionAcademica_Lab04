<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:padding="12dp">

        <TextView android:id="@+id/tvGrupoId"        android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="none" android:gravity="start" android:lineSpacingExtra="2dp"/>
        <TextView android:id="@+id/tvGrupoCiclo"     android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="none" android:gravity="start" android:lineSpacingExtra="2dp"/>
        <TextView android:id="@+id/tvGrupoCurso"     android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="none" android:gravity="start" android:lineSpacingExtra="2dp"/>
        <TextView android:id="@+id/tvGrupoNum"       android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="none" android:gravity="start" android:lineSpacingExtra="2dp"/>
        <TextView android:id="@+id/tvGrupoHorario"   android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="none" android:gravity="start" android:lineSpacingExtra="2dp"/>
        <TextView android:id="@+id/tvGrupoProfesor"  android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="none" android:gravity="start" android:lineSpacingExtra="2dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
